{
  "name": "versori-vscode",
  "displayName": "Versori",
  "description": "Status bar context indicator and command launcher for the Versori CLI",
  "version": "0.1.0",
  "publisher": "versori",
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.versori",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "versori",
          "title": "Versori",
          "icon": "media/versori.svg"
        }
      ]
    },
    "views": {
      "versori": [
        {
          "id": "versori.menu",
          "name": "Menu"
        }
      ]
    },
    "commands": [
      {
        "command": "versori.showMenu",
        "title": "Versori: Show Menu"
      },
      {
        "command": "versori.deployProject",
        "title": "Versori: Deploy Project"
      },
      {
        "command": "versori.saveVersion",
        "title": "Versori: Save Version"
      },
      {
        "command": "versori.syncProjectHere",
        "title": "Versori: Sync"
      },
      {
        "command": "versori.compareVersion",
        "title": "Versori: Compare Version"
      },
      {
        "command": "versori.compareSwapSides",
        "title": "Versori: Swap Compare Sides",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "versori.showVersions",
        "title": "Versori: Versions"
      },
      {
        "command": "versori.resources",
        "title": "Versori: Resources"
      },
      {
        "command": "versori.kvEntries",
        "title": "Versori: KV Entries"
      },
      {
        "command": "versori.kvStores",
        "title": "Versori: KV Stores"
      },
      {
        "command": "versori.connectors",
        "title": "Versori: Connectors"
      },
      {
        "command": "versori.staticConnections",
        "title": "Versori: Static Connections"
      },
      {
        "command": "versori.connections",
        "title": "Versori: Connections"
      },
      {
        "command": "versori.activations",
        "title": "Versori: Activations"
      },
      {
        "command": "versori.variables",
        "title": "Versori: Variables"
      },
      {
        "command": "versori.logs",
        "title": "Versori: Logs"
      },
      {
        "command": "versori.issues",
        "title": "Versori: Issues"
      },
      {
        "command": "versori.switchContext",
        "title": "Versori: Switch Context"
      },
      {
        "command": "versori.showOutput",
        "title": "Versori: Show Output"
      },
      {
        "command": "versori.configureKeybindings",
        "title": "Versori: Configure Keyboard Shortcuts"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "versori.syncProjectHere",
          "when": "explorerResourceIsFolder",
          "group": "versori"
        },
        {
          "command": "versori.compareVersion",
          "when": "explorerResourceIsFolder",
          "group": "versori"
        },
        {
          "command": "versori.deployProject",
          "when": "explorerResourceIsFolder",
          "group": "versori"
        },
        {
          "command": "versori.saveVersion",
          "when": "explorerResourceIsFolder",
          "group": "versori"
        }
      ],
      "editor/title": [
        {
          "command": "versori.compareSwapSides",
          "when": "activeEditor == 'multiDiffEditor'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Versori",
      "properties": {
        "versori.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `versori` binary. Leave empty to search `PATH`, then fall back to `~/go/bin/versori`. Set this if the status bar reports the CLI is missing — VS Code does not see shell aliases."
        },
        "versori.confirmDeploy": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask for confirmation before a real (non-dry-run) deploy. Ticking **Don't ask again** in the deploy panel turns this off; re-enable it here."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "watch": "npm run build -- --sourcemap --watch",
    "package": "npm run build -- --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vsix": "vsce package --no-dependencies"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
